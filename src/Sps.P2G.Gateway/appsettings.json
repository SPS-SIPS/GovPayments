{
  "ConnectionStrings": {
    "P2G": "Host=localhost;Database=sps_p2g_gateway;Username=postgres;Password=postgres"
  },
  "P2G": {
    "DescriptorHmacSecret": "development-descriptor-secret-change-me",
    "InternalApiKey": "development-internal-key-change-me"
  },
  "Callbacks": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 25,
    "MaxAttempts": 8,
    "RequestTimeoutSeconds": 10
  },
  "CallbackSecurity": {
    "RequireHttps": true,
    "AllowPrivateNetworkTargets": false
  },
  "Database": {
    "RunMigrationsOnStartup": false,
    "MigrationRetryCount": 10,
    "MigrationRetryDelaySeconds": 3
  },
  "Keycloak": {
    "Enabled": false,
    "Authority": "http://localhost:8080/realms/sps",
    "MetadataAddress": "",
    "ValidIssuer": "",
    "SymmetricSigningKey": "",
    "Audience": "sps-p2g-gateway",
    "RequireHttpsMetadata": false,
    "RevenueAuthorityRole": "p2g-authority",
    "SipsConnectRole": "p2g-sips-connect",
    "DashboardRole": "p2g-dashboard",
    "ConfigurationAdminRole": "p2g-configuration-admin",
    "SipsConnectClientId": "sips-connect-p2g"
  },
  "Auth": {
    "AllowAuthorityApiKeyFallback": true,
    "AllowSipsConnectInternalKeyFallback": true
  },
  "Health": {
    "MaxPendingOutboxMessages": 10000,
    "MaxDeadLetterCallbacks": 100
  },
  "RateLimits": {
    "Enabled": true,
    "AuthorityPermitLimit": 300,
    "SipsConnectPermitLimit": 600,
    "DashboardPermitLimit": 120,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "RequestProtection": {
    "Enabled": true,
    "MaxRequestBodyBytes": 1048576
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
