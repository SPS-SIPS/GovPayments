GATEWAY_IMAGE=ghcr.io/hanadderia/sps-p2g-gateway
GATEWAY_IMAGE_TAG=latest
HOST_IP=10.128.200.244
GATEWAY_HOST_PORT=8991

POSTGRES_DB=sps_p2g_gateway
POSTGRES_USER=sps_p2g
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_HOST_PORT=5435

OPENBAO_HOST_PORT=8992

CERT_DNS_NAMES=localhost,sps-p2g-gateway,sps-p2g-openbao
CERT_DAYS=825

P2G_DESCRIPTOR_HMAC_SECRET=change-this-descriptor-hmac-secret-at-least-32-chars
P2G_INTERNAL_API_KEY=

P2G_KEYCLOAK_AUTHORITY=https://keycloak.example/realms/sps
P2G_KEYCLOAK_AUDIENCE=sps-p2g-gateway
P2G_KEYCLOAK_REQUIRE_HTTPS_METADATA=true
P2G_KEYCLOAK_REVENUE_AUTHORITY_ROLE=p2g-authority
P2G_KEYCLOAK_SIPS_CONNECT_ROLE=p2g-sips-connect
P2G_KEYCLOAK_DASHBOARD_ROLE=p2g-dashboard
P2G_KEYCLOAK_CONFIGURATION_ADMIN_ROLE=p2g-configuration-admin
P2G_KEYCLOAK_SIPS_CONNECT_CLIENT_ID=sips-connect-p2g

SIPS_CONNECT_CLIENT_ENABLED=false
SIPS_CONNECT_BASE_URL=https://sips-connect-uat.example
SIPS_CONNECT_TOKEN_ENDPOINT=https://keycloak.example/realms/sips/protocol/openid-connect/token
SIPS_CONNECT_CLIENT_ID=sps-p2g-gateway
SIPS_CONNECT_CLIENT_SECRET=change-this-sips-connect-client-secret
SIPS_CONNECT_SCOPE=
SIPS_CONNECT_PAYMENT_STATUS_PATH=/api/v1/payments/status
SIPS_CONNECT_REQUEST_TIMEOUT_SECONDS=30
SIPS_CONNECT_REQUIRE_HTTPS=true
SIPS_CONNECT_ALLOW_INVALID_SERVER_CERTIFICATE=false

DATABASE_RUN_MIGRATIONS_ON_STARTUP=true
CALLBACKS_ENABLED=true
