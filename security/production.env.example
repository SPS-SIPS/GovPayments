ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

OpenBao__Enabled=true
OpenBao__BaseUrl=http://openbao:8200
OpenBao__TokenFile=/run/openbao/gateway_token
OpenBao__KvMount=secret
OpenBao__SecretPath=sps-p2g-gateway/runtime

Database__RunMigrationsOnStartup=true
DataProtection__ApplicationName=sps-p2g-gateway
DataProtection__PersistKeysToFileSystemPath=/var/lib/sps-p2g-gateway/data-protection-keys

Auth__AllowAuthorityApiKeyFallback=false
Auth__AllowSipsConnectInternalKeyFallback=false

Keycloak__Enabled=true
Keycloak__Authority=https://keycloak.example/realms/sps
Keycloak__Audience=sps-p2g-gateway
Keycloak__RequireHttpsMetadata=true
Keycloak__RevenueAuthorityRole=p2g-authority
Keycloak__SipsConnectRole=<sips-connect-role>
Keycloak__DashboardRole=p2g-dashboard
Keycloak__ConfigurationAdminRole=p2g-configuration-admin
Keycloak__SipsConnectClientId=<sips-connect-client-id>

SipsConnectClient__Enabled=false
SipsConnectClient__BaseUrl=https://sips-connect.example
SipsConnectClient__TokenEndpoint=https://keycloak.example/realms/sips/protocol/openid-connect/token
SipsConnectClient__ClientId=<gateway-sips-connect-client-id>
SipsConnectClient__ClientSecret=<sips-connect-client-secret>
SipsConnectClient__Scope=
SipsConnectClient__PaymentStatusPath=/api/v1/payments/status
SipsConnectClient__RequestTimeoutSeconds=30
SipsConnectClient__RequireHttps=true
SipsConnectClient__AllowInvalidServerCertificate=false

CallbackSecurity__RequireHttps=true
CallbackSecurity__AllowPrivateNetworkTargets=false
